# ==============================================================================
# CartX Merchant Dashboard — Environment Variables Configuration
# ==============================================================================
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# ==============================================================================

# Application Identity
NEXT_PUBLIC_APP_NAME="CartX"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Backend API Configuration
# Point to the shared CartX Express.js backend API
NEXT_PUBLIC_API_BASE_URL="http://localhost:5000/api/v1"

# Environment Mode
NEXT_PUBLIC_ENV="development"

